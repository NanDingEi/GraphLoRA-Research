model:
  arch: mini_gpt4rec_v2 # by default
  model_type: pretrain_vicuna
  freeze_rec: False  #
  freeze_proj: False #
  freeze_lora: False #
  max_txt_len: 1024 # by default
  proj_token_num: 1 # default:1,  the number of text token embeddings that the A single ID embedding is converted into
  proj_drop: 0 # by default
  proj_mid_times: 10 # proj_mid_times * rec embedding size = the middle layer size of the mapping module
  end_sym: "###"
  prompt_path: "prompts/collm_movie.txt"
  prompt_template: '{}'
  llama_model: "/home/bbx/user_lx/models/vicuna-7b-v0" #vicuna path
  user_num: -100
  item_num: -100
  lora_gnn: "ngcf"  # 'lightgcn', 'ngcf', 'graphsage', 'gat' , 'gcn'
  lora_scale: 1.0
  gnn_scale: 0.1
  gcn_layer: 31
  # ---- BiLoop closed-loop semantic feedback ----
  # E -> LLM_{0:semantic_layer} -> delta_h -> W_back/gate -> e_tilde -> GNN -> LLM_{gcn_layer:L}
  semantic_feedback: True
  semantic_layer: 8      # l_s: pass-1 depth, must be < gcn_layer
  feedback_detach: False # True = cut gradients through pass 1
  feedback_gate_bias_init: -2.0
  dataset: movie
  ans_type: 'v2' # by default
  rec_model: "MF" #[MF, lightgcn,.....], see "Rec2Base" class in  minigpt4/models/rec_model.py
  lora_config:
    use_lora: True
    r: 8
    alpha: 16
    target_modules: ["q_proj", "v_proj"] # ,"k_proj","up_proj","down_proj"
    dropout: 0.05
  rec_config: # recommender model config
    user_num: -100
    item_num: -100
    embedding_size: 256 #embedding size
    pretrained_path: /home/bbx/user_lx/GraphLoRA/checkpoints/0912_ml1m_oodv2_best_model_d256lr-0.001wd0.0001.pth
# /mnt/disk2/wgj_collm/weight_best/0912_ml1m_oodv2_best_model_d256lr-0.001wd0.0001.pth

  # warm start from the trained GraphLoRA checkpoint; new modules (W_back/gate) are
  # zero/negative-bias initialized, everything else is restored (strict=False)
  ckpt: /home/bbx/user_lx/GraphLoRA/output/graphlora_ml1m/20260903095/checkpoint_best.pth

#  /mnt/disk2/wgj/wgj_collm/weight_best/tallrec_ml_best_32000.pth


datasets:
  amazon_ood:
    path: /home/bbx/user_lx/GraphLoRA/dataset/ml-1m/
    train_file: train_ood2.pkl
    val_file: valid_ood2.pkl
    test_file: test_ood2.pkl
    data_type: default
    build_info:
      storage: /home/bbx/user_lx/GraphLoRA/dataset/ml-1m/

run:
  task: rec_pretrain
  lr_sched: "linear_warmup_cosine_lr"
  init_lr: 1e-4
  min_lr: 8e-5
  warmup_lr: 1e-5
  mode: 'v2' # always, please not change it


  weight_decay: 1e-3 # by default
  max_epoch: 500
  iters_per_epoch: 1000 #100
  batch_size_train: 4 # 8
  batch_size_eval: 4 # 32
  num_workers: 0
  warmup_steps: 200

  seed: 42
  output_dir: /home/bbx/user_lx/GraphLoRA/output/graphlora_ml1m_biloop #log and model saving path

  amp: True
  resume_ckpt_path: null

  evaluate: False # False: training, True: only evaluation
  train_splits: ["train"]
  valid_splits: ["valid"] # validation set
  test_splits: ["test"] # ,,"test", "valid", "test_warm" ,"test_cold" ,

  device: "cuda"
  world_size: 1
  dist_url: "env://"
  distributed: False
